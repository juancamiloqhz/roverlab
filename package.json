{
  "name": "roverlab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2"
  },
  "scripts": {
    "dev": "bunx --bun vite --host 127.0.0.1",
    "dev:server": "bun --watch server/index.ts",
    "start:server": "bun server/index.ts",
    "build": "bunx --bun vite build",
    "preview": "bunx --bun vite preview --host 127.0.0.1",
    "typecheck": "bunx --bun tsc --noEmit",
    "test": "bun test",
    "test:browser": "bunx playwright test",
    "check": "bun run typecheck && bun run build && bun test && bun run test:browser"
  },
  "dependencies": {
    "@react-three/drei": "10",
    "@react-three/fiber": "9",
    "@typesafe-ai/sdk": "^0.6.0",
    "react": "19.2",
    "react-dom": "19.2",
    "three": "0.183",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.58",
    "@types/bun": "1.3.3",
    "@types/react": "19.2",
    "@types/react-dom": "19.2",
    "@types/three": "0.183",
    "@vitejs/plugin-react": "5",
    "typescript": "5.9",
    "vite": "7"
  }
}
